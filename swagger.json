{
    "openapi": "3.0.0",
    "info": {
        "title": "Travel API",
        "description": "A REST API for managing travel places and destinations.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:3000"
        }
    ],
    "tags": [
        {
            "name": "Places",
            "description": "Travel place operations"
        },
        {
            "name": "Destinations",
            "description": "Travel destination operations"
        }
    ],
    "paths": {
        "/places": {
            "get": {
                "tags": [
                    "Places"
                ],
                "summary": "Get all places",
                "responses": {
                    "200": {
                        "description": "Places retrieved successfully"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "post": {
                "tags": [
                    "Places"
                ],
                "summary": "Create a new place",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PlaceInput"
                            },
                            "example": {
                                "name": "Mestil Hotel",
                                "description": "Luxury hotel in Kampala",
                                "category": "Hotel",
                                "country": "Uganda",
                                "city": "Kampala",
                                "address": "Nsambya",
                                "website": "https://example.com",
                                "phone": "+256700000000",
                                "priceRange": "Luxury"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Place created successfully"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        },
        "/places/{id}": {
            "get": {
                "tags": [
                    "Places"
                ],
                "summary": "Get a place by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/id"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Place retrieved successfully"
                    },
                    "400": {
                        "description": "Invalid ID"
                    },
                    "404": {
                        "description": "Place not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "put": {
                "tags": [
                    "Places"
                ],
                "summary": "Update a place",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/id"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PlaceInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Place updated successfully"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "404": {
                        "description": "Place not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Places"
                ],
                "summary": "Delete a place",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/id"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Place deleted successfully"
                    },
                    "400": {
                        "description": "Invalid ID"
                    },
                    "404": {
                        "description": "Place not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        },
        "/destinations": {
            "get": {
                "tags": [
                    "Destinations"
                ],
                "summary": "Get all destinations",
                "responses": {
                    "200": {
                        "description": "Destinations retrieved successfully"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "post": {
                "tags": [
                    "Destinations"
                ],
                "summary": "Create a new destination",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DestinationInput"
                            },
                            "example": {
                                "name": "Kampala",
                                "country": "Uganda",
                                "description": "Capital city of Uganda",
                                "bestSeason": "June-August",
                                "featured": true
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Destination created successfully"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        },
        "/destinations/{id}": {
            "get": {
                "tags": [
                    "Destinations"
                ],
                "summary": "Get a destination by ID",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/id"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Destination retrieved successfully"
                    },
                    "400": {
                        "description": "Invalid ID"
                    },
                    "404": {
                        "description": "Destination not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "put": {
                "tags": [
                    "Destinations"
                ],
                "summary": "Update a destination",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/id"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DestinationInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Destination updated successfully"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "404": {
                        "description": "Destination not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Destinations"
                ],
                "summary": "Delete a destination",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/id"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Destination deleted successfully"
                    },
                    "400": {
                        "description": "Invalid ID"
                    },
                    "404": {
                        "description": "Destination not found"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        }
    },
    "components": {
        "parameters": {
            "id": {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "MongoDB document ID",
                "schema": {
                    "type": "string"
                }
            }
        },
        "schemas": {
            "PlaceInput": {
                "type": "object",
                "required": [
                    "name",
                    "description",
                    "category",
                    "country",
                    "city",
                    "address",
                    "website",
                    "phone",
                    "priceRange"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    },
                    "website": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "string"
                    },
                    "priceRange": {
                        "type": "string"
                    }
                }
            },
            "DestinationInput": {
                "type": "object",
                "required": [
                    "name",
                    "country",
                    "description",
                    "bestSeason",
                    "featured"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "country": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "bestSeason": {
                        "type": "string"
                    },
                    "featured": {
                        "type": "boolean"
                    }
                }
            }
        }
    }
}